# Token of the transcriber: the same value as HTTP_SINK_TOKEN in .env of livekit-transcript
# python -c "import secrets; print(secrets.token_urlsafe(32))"
HTTP_SINK_TOKEN=

# Default 127.0.0.1; the Docker image sets 0.0.0.0 — do not set it here for Docker
# HOST=127.0.0.1
PORT=8787
# A session without events for this long is shown as "no events" (crashed transcriber or a silent call)
SESSION_IDLE_TIMEOUT_S=300
# A finished session (ended or idle) is removed from memory this long after its last event;
# until then it can be downloaded as JSON from the UI
SESSION_RETENTION_S=1800
